# =============================================================================
# QuantEdge Live Market Gateway - environment template
# =============================================================================
# Copy to `.env` and fill in. NEVER commit `.env` (it is git-ignored).
# Every value below is a placeholder. Leaving a key blank disables its provider
# cleanly -- the gateway degrades, it does not crash and does not invent data.
# =============================================================================

# ---- Application ------------------------------------------------------------
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                     # json | console

# ---- Persistence ------------------------------------------------------------
# Leave DATABASE_URL blank to use the bundled local SQLite file.
# Set it to a Postgres/Supabase DSN for production, e.g.
#   postgresql+psycopg://user:pass@host:5432/postgres
DATABASE_URL=
SQLITE_PATH=data/quantedge.db       # used only when DATABASE_URL is blank

# Supabase. SUPABASE_SERVICE_ROLE_KEY is the long JWT starting with "eyJ".
# A token starting with "sbp_" is a Management-API personal access token and
# CANNOT be used here -- see docs/credentials.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Market data providers --------------------------------------------------
PRIMARY_FOREX_PROVIDER=twelvedata   # oanda | twelvedata

TWELVE_DATA_API_KEY=

OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice          # practice | live  (read-only either way)

# ---- Economic calendar / news providers -------------------------------------
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# Generic calendar slot for a vendor confirmed by scripts/probe_credentials.py.
# CALENDAR_PROVIDER must name an implemented adapter, otherwise event risk
# reports UNKNOWN (never LOW by assumption).
CALENDAR_PROVIDER=
CALENDAR_API_KEY=

# ---- LLM providers ----------------------------------------------------------
LLM_PROVIDER=agentrouter            # agentrouter | anthropic | disabled

AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=
AGENTROUTER_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Binance (public market data only; no key required, no private endpoints)-
BINANCE_REST_BASE_URL=https://data-api.binance.vision
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443
BINANCE_STREAM_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT
BINANCE_STREAM_INTERVALS=1m,5m

# ---- HTTP API ---------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated exact origins. "*" is rejected when APP_ENV=production.
CORS_ALLOW_ORIGINS=http://localhost:3000
# Optional bearer token gate for the future website. Blank = open (dev only);
# required when APP_ENV=production.
API_AUTH_TOKEN=

# ---- Deployment (not read by the gateway itself) ----------------------------
VERCEL_TOKEN=
SUPABASE_ACCESS_TOKEN=
